{
  "name": "im-agent-team",
  "version": "0.2.0",
  "description": "IM-based multi-agent team bridge for DeepSeek Harness: turn members of a Feishu group into collaborating agents.",
  "license": "MIT",
  "author": "minjorx",
  "repository": {
    "type": "git",
    "url": "https://github.com/minjorx/im-agent-team.git"
  },
  "homepage": "https://github.com/minjorx/im-agent-team",
  "bugs": {
    "url": "https://github.com/minjorx/im-agent-team/issues"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "feishu",
    "lark",
    "bot",
    "multi-agent",
    "agent-team",
    "im",
    "team"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "im-agent-team-onboard": "./bin/onboard.mjs",
    "im-agent-team-role": "./bin/role.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "qrcode": "^1.5.4"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "runtimes/dsh",
    "bin",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/unit.test.js test/controller.test.js test/memory.test.js",
    "pack": "pnpm pack",
    "onboard": "node bin/onboard.mjs"
  }
}
